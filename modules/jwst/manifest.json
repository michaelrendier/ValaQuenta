    },
    "tools": [
      {
        "name": "spectral_to_octonion",
        "equation": "spectral_to_octonion",
        "label": "Spectral To Octonion",
        "desc": "8 NIRCam filters → 𝕆 element  [process= not set]",
        "params": [
          "intensities"
        ]
      },
      {
        "name": "cd_spectral_address",
        "equation": "cd_spectral_address",
        "label": "Cd Spectral Address",
        "desc": "Cayley-Dickson spectral pixel address  [process= not set]",
        "params": [
          "intensities",
          "pixel_x",
          "pixel_y"
        ]
      },
      {
        "name": "synthetic_hydrogen",
        "equation": "synthetic_hydrogen",
        "label": "Synthetic Hydrogen",
        "desc": "Synthetic Paschen series spectrum (hydrogen)  [process= not set]",
        "params": []
      },
      {
        "name": "synthetic_stellar",
        "equation": "synthetic_stellar",
        "label": "Synthetic Stellar",
        "desc": "Synthetic blackbody T=5000K spectrum  [process= not set]",
        "params": []
      },
      {
        "name": "lambda_to_r",
        "equation": "lambda_to_r",
        "label": "Lambda To R",
        "desc": "λ (nm) → r ∈ (0,1)  radial coordinate  [process= not set]",
        "params": [
          "wavelength_nm"
        ]
      }
    ],
    "display_modes": [
      "text",
