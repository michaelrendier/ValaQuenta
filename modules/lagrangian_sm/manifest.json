{
  "schema": "valaquenta.plugin/1",
  "format_version": 1,
  "id": "org.ainulindale.lagrangian_sm",
  "type": "engine",
  "name": "lagrangian_sm",
  "display": "L_SM: the Standard Model Lagrangian",
  "version": "0.1",
  "summary": "The Standard Model of particle physics as an engine: field content, anomaly cancellation, group structure, symbolic electroweak masses and Higgs expansion, the 19/26/28 parameter count, tree relations against PDG, mixing, running, and a measured comparison with the VAPMIP L_NN and with L_(I|O).",
  "confidence_floor": "ESTABLISHED",
  "license": "GPL-3.0-only",
  "entry": {
    "module": "ValaQuenta.modules.lagrangian_sm",
    "class": "LagrangianSMModule"
  },
  "permissions": [],
  "dependencies": {},
  "provenance": {
    "origin": "Cody, 2026-11-19: 'there is not an engine for the Standard Model of Particle Physics ... build a L_sm engine ... so that we can test all three lagrangians here and there as time goes on'. Built from the textbook construction (gauge group + field content + renormalisability + Higgs mechanism); measured inputs from the PDG tables (particle 1.1.1) and NuFIT. It is the control for L_NN (modules/lagrangian) and L_(I|O) (modules/l_io_photon_path). No framework constant is used. The comparison functions measure the coded L_NN, they do not argue it.",
    "authors": [
      "Cody Michael Allison"
    ],
    "created": "2026-11-19",
    "status_label": "ESTABLISHED",
    "predecessors": [
      "lagrangian",
      "witches_hat",
      "l_io_photon_path"
    ],
    "citations": [],
    "wiki": {
      "ainulindale": "Ainulindale/wiki/139_three_lagrangians.md",
      "valaquenta": "ValaQuenta/wiki/lagrangian_sm.md"
    },
    "notebook": "ValaQuenta/notebooks/engines/25_lagrangian_sm.ipynb",
    "proof_locale": "ValaQuenta/engine/proof_locale/lagrangian_sm.json"
  },
  "environment": {
    "constants": [
      {
        "symbol": "1/α(M_Z)",
        "role": "inverse fine-structure constant, MSbar",
        "value": 127.951,
        "source": "PDG Review"
      },
      {
        "symbol": "sin²θ_W",
        "role": "weak mixing angle, MSbar at M_Z",
        "value": 0.23122,
        "source": "PDG Review"
      },
      {
        "symbol": "α_s(M_Z)",
        "role": "strong coupling",
        "value": 0.118,
        "source": "PDG Review"
      },
      {
        "symbol": "G_F",
        "role": "Fermi constant, GeV^-2",
        "value": 1.1663788e-05,
        "source": "PDG Review"
      },
      {
        "symbol": "masses",
        "role": "fermion, W, Z, Higgs masses",
        "value": null,
        "source": "PDG tables via the particle package"
      }
    ],
    "native_space": "field space of the gauge group SU(3)×SU(2)×U(1); the (h, G) Higgs-doublet plane for the hat",
    "arithmetic": "float64; fractions.Fraction for the anomaly sums; sympy for the symbolic derivations",
    "requires_engines": [
      "witches_hat",
      "lagrangian"
    ],
    "external": [
      "numpy",
      "scipy",
      "sympy",
      "particle"
    ]
  },
